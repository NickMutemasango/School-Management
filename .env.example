# Supabase project settings -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses Row Level Security - never expose to the browser.
# Used for admin-triggered account creation (student enrollment, staff approval).
SUPABASE_SERVICE_ROLE_KEY=

# Domain used to build internal login emails for students, e.g.
# "REG-2024-0012" -> "reg-2024-0012@students.innovate-institute.internal"
# Doesn't need to receive mail - it's only an identifier for Supabase Auth.
STUDENT_AUTH_EMAIL_DOMAIN=students.innovate-institute.internal

# Optional. Restricts the staff Google sign-in account picker to a Google
# Workspace domain, e.g. "innovate-institute.ac.zw". Leave blank to allow any
# Google account (rely on admin approval instead).
NEXT_PUBLIC_STAFF_GOOGLE_HD=

# Resend (resend.com) API key, used to email admins when a new staff account
# is awaiting approval. Without it, the app logs a warning and skips sending
# instead of failing sign-in.
RESEND_API_KEY=

# Optional. Defaults to Resend's shared testing domain (onboarding@resend.dev),
# which works immediately with no DNS setup but only sends to your own Resend
# account's verified addresses. Set this to a "Name <you@yourdomain.com>"
# address once you verify a domain in Resend for real delivery.
RESEND_FROM_EMAIL=
